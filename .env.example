# Copy this file to `.env` and fill in the values:
#   cp .env.example .env
# `.env` is git-ignored. Never commit real keys.

# SQLite database file (relative to the project root). Created by `npx prisma migrate dev`.
DATABASE_URL="file:./dev.db"

# Secret used to sign login cookies. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=""

# 32-byte key (base64) used to encrypt CVs, job postings and AI results at rest. Generate with:
#   openssl rand -base64 32
# If you change it, previously stored data can no longer be decrypted (run `npx prisma migrate reset`).
ENCRYPTION_KEY=""

# Optional. Without a key the app runs in demo mode with prewritten responses.
# Get a key at https://console.anthropic.com (Billing -> add credit -> API Keys -> Create key).
ANTHROPIC_API_KEY=""

# Which Claude model to use when a key is set. Haiku is the cheapest (about $0.002 per analysis).
CLAUDE_MODEL="claude-haiku-5-5"

# "auto" = use Claude when ANTHROPIC_API_KEY is set, otherwise demo mode.
# "mock" = always demo mode (used by the automated tests, or to save credit).
AI_MODE="auto"
